# Server Configuration
PORT=4000
DATABASE_URL="file:./dev.db"
JWT_SECRET=replace_this_with_a_secure_random_string_at_least_32_characters_long
FRONTEND_ORIGIN=http://localhost:5173

# Admin Initial Credentials (used by seed script)
ADMIN_EMAIL=admin@thewanted.lk
ADMIN_PASSWORD=AdminSecurePassword123!

# Tracking URL Template (Optional: {trackingNumber} placeholder)
TRACKING_URL_TEMPLATE=https://tracking.post.lk/?id={trackingNumber}

# Seed File Path for Products (relative to workspace or absolute)
PRODUCTS_SEED_FILE=src/data/products.json

# Store & Shipping Configuration (used to seed initial Settings)
SHIPPING_FEE=0
FREE_SHIPPING_THRESHOLD=
ESTIMATED_DELIVERY="To be confirmed"
ENABLED_PAYMENT_METHODS_POST="cod,bank_transfer"
ENABLED_PAYMENT_METHODS_PICKUP="pay_at_shop,bank_transfer"
BANK_TRANSFER_INSTRUCTIONS="Commercial Bank, Account: 1234567890, Branch: Kandy"
SHOP_ADDRESS="Shop address"
SHOP_HOURS="Opening hours"
SHOP_PHONE="+94 7X XXX XXXX"
SHOP_MAP_URL=""
PICKUP_NOTE="We will contact you when your order is ready."
